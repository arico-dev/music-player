<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Instancias estáticas por peso (Google Fonts, OFL). Se usan ficheros
         independientes en vez de la variable-font con defecto wght=200 para que
         el peso solicitado se resuelva con el matching estándar de familias y
         nunca se caiga a ExtraLight por defecto. -->
    <font
        android:font="@font/nunito_extra_light"
        android:fontStyle="normal"
        android:fontWeight="200" />
    <font
        android:font="@font/nunito_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/nunito_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/nunito_semi_bold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/nunito_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/nunito_extra_bold"
        android:fontStyle="normal"
        android:fontWeight="800" />
</font-family>
